# =========================================
# Intelligent Platform for Digital Identity
# Protection and Cyber Threat Analysis
# Environment Configuration Template
# =========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------
# Server
# ---------------------
PORT=5000
NODE_ENV=development

# ---------------------
# Database
# ---------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aitrustlens

# ---------------------
# Authentication
# ---------------------
JWT_SECRET=your-very-long-random-jwt-secret-here
JWT_EXPIRES_IN=7d

# ---------------------
# OpenRouter (AI Explanations)
# ---------------------
OPENROUTER_API_KEY=sk-or-v1-...

# ---------------------
# VirusTotal (Threat Intelligence)
# ---------------------
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# ---------------------
# Google Safe Browsing
# ---------------------
GOOGLE_SAFE_BROWSING_API_KEY=your-safe-browsing-key

# ---------------------
# Google Fact Check
# ---------------------
GOOGLE_FACTCHECK_API_KEY=your-factcheck-key

# ---------------------
# URLScan.io
# ---------------------
URLSCAN_API_KEY=your-urlscan-api-key

# ---------------------
# Rate Limiting
# ---------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------
# CORS
# ---------------------
CLIENT_URL=http://localhost:5173

# ---------------------
# File Uploads
# ---------------------
MAX_FILE_SIZE_MB=10
UPLOAD_TEMP_DIR=uploads/temp
